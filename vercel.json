{
    "version": 2,
    "functions": {
        "api/*.js": {
            "runtime": "nodejs20.x"
        }
    },
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "s-maxage=300, stale-while-revalidate=60"
                }
            ]
        }
    ]
}